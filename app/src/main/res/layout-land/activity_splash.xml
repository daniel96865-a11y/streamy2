<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_splash"
    android:fitsSystemWindows="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="48dp"
        android:paddingEnd="48dp">

        <FrameLayout
            android:layout_width="316dp"
            android:layout_height="316dp"
            android:clipChildren="false">

            <View
                android:id="@+id/splashGlow"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0"
                android:background="@drawable/splash_glow" />

            <ImageView
                android:id="@+id/splashLogo"
                android:layout_width="228dp"
                android:layout_height="228dp"
                android:layout_gravity="center"
                android:contentDescription="@string/app_name"
                android:scaleType="fitCenter"
                android:src="@drawable/streamy_logo" />
        </FrameLayout>

        <TextView
            android:id="@+id/splashTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-40dp"
            android:text="@string/app_name"
            android:textColor="#F5FBFF"
            android:textSize="48sp"
            android:textStyle="bold"
            android:letterSpacing="0.01" />

        <TextView
            android:id="@+id/splashSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/splash_subtitle"
            android:textColor="#9EDCFF"
            android:textSize="19sp"
            android:letterSpacing="0.06" />

        <FrameLayout
            android:id="@+id/splashTrack"
            android:layout_width="390dp"
            android:layout_height="9dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/splash_track_clip">

            <ProgressBar
                android:id="@+id/splashProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:indeterminate="false"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/splash_progress" />

            <View
                android:id="@+id/splashShimmer"
                android:layout_width="72dp"
                android:layout_height="match_parent"
                android:alpha="0"
                android:background="@drawable/splash_shimmer" />
        </FrameLayout>

        <TextView
            android:id="@+id/splashStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="13dp"
            android:text="@string/splash_loading"
            android:textColor="#D8EEFF"
            android:textSize="17sp"
            android:letterSpacing="0.04" />

    </LinearLayout>
</FrameLayout>
