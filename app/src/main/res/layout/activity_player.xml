<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/playerRoot"
    android:background="@android:color/black"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:keepScreenOn="true"
        app:keep_content_on_player_reset="true"
        app:resize_mode="zoom"
        app:show_buffering="when_playing"
        app:shutter_background_color="@android:color/black"
        app:surface_type="texture_view"
        app:use_controller="false"/>
    <FrameLayout
        android:id="@+id/vlcHost"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <View
        android:id="@+id/tapLayer"
        android:background="@android:color/transparent"
        android:focusable="false"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ImageButton
        android:layout_gravity="center"
        android:id="@+id/btnPlay"
        android:background="@drawable/bg_play_circle"
        android:padding="18dp"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:src="@drawable/ic_pause"
        android:scaleType="centerInside"
        android:contentDescription="Pause"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:id="@+id/topBar"
        android:background="@drawable/bg_player_top"
        android:paddingTop="8dp"
        android:paddingBottom="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="4dp"
        android:paddingEnd="16dp">
        <TextView
            android:textSize="32sp"
            android:textColor="@color/fg"
            android:gravity="center"
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="‹"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/fg"
                android:ellipsize="end"
                android:id="@+id/playerTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"/>
            <TextView
                android:textSize="12sp"
                android:textColor="#ccffffff"
                android:ellipsize="end"
                android:id="@+id/playerSub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"/>
        </LinearLayout>
        <TextView
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/fg"
            android:id="@+id/clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <LinearLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:id="@+id/bottomBar"
        android:background="@drawable/bg_player_bottom"
        android:paddingTop="20dp"
        android:paddingBottom="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/fg"
            android:ellipsize="end"
            android:id="@+id/epgNow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="11sp"
                android:textColor="#b3ffffff"
                android:id="@+id/epgStart"
                android:layout_width="52dp"
                android:layout_height="wrap_content"
                android:text="00:00"/>
            <SeekBar
                android:id="@+id/epgSeek"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:max="1000"
                android:layout_weight="1"
                android:progressTint="@color/accent"
                android:thumbTint="@color/fg"/>
            <TextView
                android:textSize="11sp"
                android:textColor="#b3ffffff"
                android:gravity="end"
                android:id="@+id/epgEnd"
                android:layout_width="52dp"
                android:layout_height="wrap_content"
                android:text="00:00"/>
        </LinearLayout>
        <TextView
            android:textSize="12sp"
            android:textColor="#b3ffffff"
            android:ellipsize="end"
            android:id="@+id/epgNext"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"/>
        <HorizontalScrollView
            android:id="@+id/epgBtns"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/fg"
                    android:gravity="center"
                    android:id="@+id/badgeLive"
                    android:background="@drawable/bg_live"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="LIVE"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/fg"
                    android:gravity="center"
                    android:id="@+id/btnPrevCh"
                    android:background="@drawable/bg_btn_sec"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="◀"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:layout_marginStart="8dp"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/fg"
                    android:gravity="center"
                    android:id="@+id/btnNextCh"
                    android:background="@drawable/bg_btn_sec"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="▶"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:layout_marginStart="8dp"/>
                <TextView
                    android:textSize="13sp"
                    android:textColor="@color/fg"
                    android:gravity="center"
                    android:id="@+id/btnEpg"
                    android:background="@drawable/bg_btn_sec"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="EPG"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:layout_marginStart="8dp"/>
                <TextView
                    android:textSize="13sp"
                    android:textColor="@color/accent_fg"
                    android:gravity="center"
                    android:id="@+id/btnPlayer"
                    android:background="@drawable/bg_btn"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="Auto"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:layout_marginStart="8dp"/>
                <TextView
                    android:textSize="13sp"
                    android:textColor="@color/fg"
                    android:gravity="center"
                    android:id="@+id/btnResize"
                    android:background="@drawable/bg_btn_sec"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="Füllen"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:layout_marginStart="8dp"/>
                <TextView
                    android:textSize="13sp"
                    android:textColor="@color/fg"
                    android:gravity="center"
                    android:id="@+id/btnDiag"
                    android:background="@drawable/bg_btn_sec"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="Diag"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:layout_marginStart="8dp"/>
                <TextView
                    android:textSize="11sp"
                    android:textColor="#b3ffffff"
                    android:id="@+id/archiveHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"/>
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>
    <LinearLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:id="@+id/epgSheet"
        android:background="#f2000000"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="280dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:paddingTop="8dp"
            android:paddingBottom="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="8dp">
            <TextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/fg"
                android:id="@+id/epgSheetTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Programm"
                android:layout_weight="1"/>
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/accent_fg"
                android:gravity="center"
                android:id="@+id/btnCloseEpg"
                android:background="@drawable/bg_btn"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="✕"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"/>
        </LinearLayout>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/muted"
            android:id="@+id/epgNavHint"
            android:paddingBottom="6dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sendung antippen"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/epgList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </LinearLayout>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/danger"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/playerError"
        android:padding="24dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</FrameLayout>
