<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+: plain dark start window without the app icon; the "Farbwellen" animation follows. -->
    <style name="Theme.Streamy.Splash" parent="Theme.Streamy">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowSplashScreenBackground">@color/bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/intro_blank</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
    </style>
</resources>
