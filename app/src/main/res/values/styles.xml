<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Streamy" parent="Theme.MaterialComponents.NoActionBar">
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:textColorPrimary">@color/fg</item>
        <item name="android:textColorSecondary">@color/muted</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:textColor">@color/fg</item>
        <item name="android:textColorHint">@color/muted</item>
        <item name="android:editTextColor">@color/fg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:defaultFocusHighlightEnabled">true</item>
        <item name="alertDialogTheme">@style/Theme.Streamy.Dialog</item>
        <item name="colorControlActivated">@color/accent</item>
        <item name="colorControlHighlight">@color/accent</item>
        <item name="colorOnPrimary">@color/accent_fg</item>
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryVariant">@color/elevated</item>
        <item name="colorSecondary">@color/brand</item>
    </style>
    <style name="Theme.Streamy.Dialog" parent="Theme.MaterialComponents.Dialog.Alert">
        <item name="android:textColorPrimary">@color/fg</item>
        <item name="android:textColor">@color/fg</item>
        <item name="android:background">@color/card</item>
        <item name="android:listSelector">@drawable/bg_row</item>
        <item name="android:colorControlHighlight">@color/accent</item>
        <item name="colorPrimary">@color/accent</item>
    </style>
    <style name="Tab" parent="">
        <item name="android:textSize">14.5sp</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:background">@drawable/bg_focus</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:layout_marginEnd">28dp</item>
    </style>
</resources>
