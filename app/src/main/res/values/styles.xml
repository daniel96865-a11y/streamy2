<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Streamy" parent="Theme.MaterialComponents.NoActionBar">
        <item name="streamyBg">@color/bg</item>
        <item name="streamySurface">@color/dark_surface</item>
        <item name="streamyCard">@color/card</item>
        <item name="streamyElevated">@color/elevated</item>
        <item name="streamyLiveBg">@color/live_bg</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:textColorPrimary">@color/fg</item>
        <item name="android:textColorSecondary">@color/muted</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:textColor">@color/fg</item>
        <item name="android:textColorHint">@color/muted</item>
        <item name="android:editTextColor">@color/fg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:defaultFocusHighlightEnabled">true</item>
        <item name="alertDialogTheme">@style/Theme.Streamy.Dialog</item>
        <item name="colorControlActivated">?attr/streamyAccent</item>
        <item name="colorControlHighlight">?attr/streamyAccent</item>
        <item name="colorOnPrimary">?attr/streamyOnAccent</item>
        <item name="colorPrimary">?attr/streamyAccent</item>
        <item name="colorPrimaryVariant">@color/elevated</item>
        <item name="colorSecondary">?attr/streamyAccent</item>
        <item name="streamyAccent">#FF5B9DFF</item>
        <item name="streamyOnAccent">#FF061428</item>
        <item name="streamyAccentSoft">#665B9DFF</item>
        <item name="streamyAccentTrack">#335B9DFF</item>
        <item name="streamyAccentIconBg">#285B9DFF</item>
        <item name="streamyAccentSurface">#FF26354D</item>
        <item name="streamyAccentSurfaceDim">#FF202A3A</item>
        <item name="streamyAccentSurfaceGlass">#CC26354D</item>
    </style>

    <!-- Design „OLED-Schwarz“: pure black backgrounds, very dark surfaces; accent unchanged. -->
    <style name="ThemeOverlay.Streamy.Design.Oled" parent="">
        <item name="streamyBg">@color/oled_bg</item>
        <item name="streamySurface">@color/oled_surface</item>
        <item name="streamyCard">@color/oled_card</item>
        <item name="streamyElevated">@color/oled_elevated</item>
        <item name="streamyLiveBg">@color/oled_live_bg</item>
        <item name="android:colorBackground">@color/oled_bg</item>
        <item name="android:windowBackground">@color/oled_bg</item>
        <item name="android:statusBarColor">@color/oled_bg</item>
        <item name="android:navigationBarColor">@color/oled_bg</item>
        <item name="colorPrimaryVariant">@color/oled_elevated</item>
    </style>

    <style name="Theme.Streamy.Splash" parent="Theme.Streamy">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="Theme.Streamy.Dialog" parent="Theme.MaterialComponents.Dialog.Alert">
        <item name="android:textColorPrimary">@color/fg</item>
        <item name="android:textColor">@color/fg</item>
        <item name="android:background">?attr/streamyCard</item>
        <item name="android:listSelector">@drawable/bg_row</item>
        <item name="android:colorControlHighlight">?attr/streamyAccent</item>
        <item name="colorPrimary">?attr/streamyAccent</item>
    </style>
    <style name="Tab" parent="">
        <item name="android:textSize">14.5sp</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:background">@drawable/bg_focus</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:layout_marginEnd">28dp</item>
    </style>
</resources>
