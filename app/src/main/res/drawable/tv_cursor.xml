<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <size
                android:height="56dp"
                android:width="56dp"/>
            <solid android:color="#33000000"/>
        </shape>
    </item>
    <item
        android:left="6dp"
        android:top="6dp"
        android:right="6dp"
        android:bottom="6dp">
        <shape android:shape="oval">
            <solid android:color="#55ffffff"/>
            <stroke
                android:width="3dp"
                android:color="#ffffffff"/>
        </shape>
    </item>
    <item
        android:left="20dp"
        android:top="20dp"
        android:right="20dp"
        android:bottom="20dp">
        <shape android:shape="oval">
            <solid android:color="#ffff3b30"/>
            <stroke
                android:width="2dp"
                android:color="#ffffffff"/>
        </shape>
    </item>
</layer-list>
