<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#26354D"/>
            <stroke android:width="3dp" android:color="@color/accent"/>
            <corners android:radius="18dp"/>
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#26354D"/>
            <stroke android:width="2dp" android:color="@color/accent"/>
            <corners android:radius="18dp"/>
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#202A3A"/>
            <stroke android:width="1dp" android:color="#665B9DFF"/>
            <corners android:radius="18dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/elevated"/>
            <corners android:radius="18dp"/>
        </shape>
    </item>
</selector>
